# sferic-tab5 — sdkconfig defaults for the [env:cam] hybrid (arduino+espidf)
# build. Camera bits cribbed from amcchord/M5Tab5-VideoLink.

# ESP32-P4 "ES" pre-rev-3.0 silicon on the Tab5 (rev 1.x). Remove if a rev3+ unit.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_0=y

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

# 32 MB PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# --- Camera: SC202CS over MIPI-CSI + ISP/IPA pipeline (esp_video) ---
CONFIG_CAMERA_SC202CS=y
CONFIG_CAMERA_SC202CS_DEFAULT_IPA_JSON_CONFIGURATION_FILE=y
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y
CONFIG_ISP_PIPELINE_CONTROLLER_TASK_STACK_USE_PSRAM=y
